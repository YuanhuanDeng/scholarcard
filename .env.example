# Copy this file to .env.local and fill in your actual values
# .env.local is gitignored — never commit your real secrets

# Supabase (https://supabase.com → your project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Anthropic Claude API (https://console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# SerpAPI for Google Scholar import (https://serpapi.com → free signup → API Key)
SERPAPI_KEY=your-serpapi-key-here

# App config
NEXT_PUBLIC_APP_DOMAIN=scholarcard.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
